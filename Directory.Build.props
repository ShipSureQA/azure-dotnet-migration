<Project>
  <PropertyGroup>
    <!-- Every library, the API and the test projects build for BOTH frameworks.
         This is how the net8.0 -> net10.0 upgrade is proven: same code, same tests, two runtimes. -->
    <OrdersTargetFrameworks>net8.0;net10.0</OrdersTargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pinned while multi-targeting so both frameworks compile the exact same language.
         Remove (and enjoy C# 14) once net8.0 is dropped. See docs/UPGRADE.md. -->
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>

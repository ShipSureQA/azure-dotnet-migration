<Project>
  <!-- Central Package Management: one place for every version (Dependabot updates this file).
       All versions verified on nuget.org in November 2026. -->
  <PropertyGroup>
    <!-- The Azure Functions build generates obj/**/WorkerExtensions.csproj with its own pinned versions;
         it must not inherit central package management (would fail with NU1008). -->
    <ManagePackageVersionsCentrally Condition="'$(MSBuildProjectName)' != 'WorkerExtensions'">true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Azure">
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.2" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.2" />
  </ItemGroup>

  <ItemGroup Label="Azure Functions (isolated worker)">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.4" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Framework-aligned packages: the version must match the runtime the test host runs on. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(OrdersTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Orders.Messaging</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- IConfiguration, DI, logging and options come from the shared framework, so no
         Microsoft.Extensions.* versions need to be pinned per target framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Storage.Queues" />
  </ItemGroup>
</Project>

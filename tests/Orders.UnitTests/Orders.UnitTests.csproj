<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(OrdersTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Orders.Core\Orders.Core.csproj" />
    <ProjectReference Include="..\..\src\Orders.Messaging\Orders.Messaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Infra files validated by the tests. -->
    <None Include="..\..\infra\apim\*.xml" Link="infra\apim\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\infra\servicebus-emulator\Config.json" Link="infra\servicebus-emulator\Config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
